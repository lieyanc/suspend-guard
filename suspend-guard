#!/usr/bin/env bash
# suspend-guard: 当 claude/codex/opencode 在干活(以真实网络流量为主判定,纯空闲挂着不算),
# 或存在 RDP 连接时,持有 logind 抑制锁(block)阻止系统挂起。
# 网络流量按 agent 进程树名下每条 established TCP 连接的 bytes_sent+bytes_received
# 增量统计(ss -ti,含回环,兼容本地代理场景,无需 root);CPU 仅作高阈值兜底,
# 用于编译/测试等无网络的纯本地重活。
# 参数可在 ~/.config/suspend-guard.conf 覆盖(shell 语法)。
set -u

[ -r "$HOME/.config/suspend-guard.conf" ] && . "$HOME/.config/suspend-guard.conf"

: "${INTERVAL:=15}"                # 采样窗口(秒)
: "${BUSY_NET_KB:=5}"              # 任一 agent 进程树窗口内网络收发 ≥ 该值(KB)视为忙碌(主信号)
: "${BUSY_CPU_SECS:=4}"            # 任一 agent 进程树窗口内 CPU ≥ 该秒数视为忙碌(兜底信号)
: "${IDLE_WINDOWS_TO_RELEASE:=12}" # 连续空闲窗口达到此数才释放锁(12×15s=180s)
: "${AGENT_RE:=claude|codex|opencode}" # 按进程名 comm 全词匹配,自动包含其全部后代进程
: "${RDP_PORTS:=3389}"             # RDP 监听端口,空格分隔

RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
FORCE_FILE="$RUNDIR/suspend-guard.force"   # 存在即无条件保持唤醒(托盘"常亮"开关)
STATE_FILE="$RUNDIR/suspend-guard.state"   # 供托盘读取:held|idle + 原因 + 指标

CLK_TCK=$(getconf CLK_TCK)
CPU_THRESH=$((BUSY_CPU_SECS * CLK_TCK))
NET_THRESH=$((BUSY_NET_KB * 1024))

declare -A prev_cpu prev_net
inhibit_pid=""
idle_windows=0
MAX_CPU_DELTA=0
MAX_NET_DELTA=0
AGENT_BUSY=0

release() {
  [ -z "$inhibit_pid" ] && return
  pkill -TERM -P "$inhibit_pid" 2>/dev/null
  kill -TERM "$inhibit_pid" 2>/dev/null
  wait "$inhibit_pid" 2>/dev/null
  inhibit_pid=""
}
trap 'release; rm -f "$STATE_FILE"; exit 0' TERM INT EXIT

hold() {
  if [ -n "$inhibit_pid" ] && kill -0 "$inhibit_pid" 2>/dev/null; then return; fi
  systemd-inhibit --what=sleep:idle --mode=block \
    --who="suspend-guard" --why="$1" sleep infinity &
  inhibit_pid=$!
  echo "acquire: $1"
}

rdp_active() {
  local p
  for p in $RDP_PORTS; do
    [ -n "$(ss -Htn state established "( sport = :$p )" 2>/dev/null)" ] && return 0
  done
  return 1
}

# 分别统计每棵 agent(claude/codex/opencode)进程树本窗口的网络收发字节与 CPU(jiffies)增量,
# 避免多个空闲会话的后台开销相加后误判忙碌。cutime/cstime 一并计入,不漏窗口内退出的短命子进程。
sample_agents() {
  local pid ppid root c stat cpu roots line key rest owned_root l p s r total d
  MAX_CPU_DELTA=0 MAX_NET_DELTA=0 AGENT_BUSY=0
  declare -A child owner cur_cpu cur_net root_cpu root_net want
  roots=$(pgrep -x "$AGENT_RE" || true)
  if [ -n "$roots" ]; then
    while read -r pid ppid; do
      child[$ppid]+=" $pid"
    done < <(ps -eo pid=,ppid=)
    local -a queue
    for root in $roots; do
      queue=("$root")
      while [ "${#queue[@]}" -gt 0 ]; do
        pid=${queue[0]}; queue=("${queue[@]:1}")
        [ -n "${want[$pid]:-}" ] && continue
        want[$pid]=1
        owner[$pid]=$root
        for c in ${child[$pid]:-}; do queue+=("$c"); done
      done
    done

    # CPU(兜底信号)
    for pid in "${!want[@]}"; do
      stat=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
      stat=${stat##*) }   # 去掉 "pid (comm) " 前缀,comm 可能含空格括号
      set -- $stat        # 此后 utime/stime/cutime/cstime 为 $12 $13 $14 $15
      cpu=$(( ${12} + ${13} + ${14} + ${15} ))
      cur_cpu[$pid]=$cpu
      d=$(( cpu - ${prev_cpu[$pid]:-$cpu} ))
      [ "$d" -lt 0 ] && d=0
      root=${owner[$pid]}
      root_cpu[$root]=$(( ${root_cpu[$root]:-0} + d ))
    done

    # 网络(主信号):ss -i 输出为「连接行(顶格)+ 详情行(缩进)」交替;
    # 只统计属于 agent 树的连接,按 local>peer 记增量,计数器重置时钳为 0
    key="" owned_root=""
    while IFS= read -r line; do
      if [[ $line != [[:space:]]* ]]; then
        key="" owned_root=""
        if [[ $line == *users:\(* ]]; then
          rest=$line
          while [[ $rest =~ pid=([0-9]+)(.*) ]]; do
            pid=${BASH_REMATCH[1]}
            if [ -z "$owned_root" ] && [ -n "${want[$pid]:-}" ]; then
              owned_root=${owner[$pid]}
            fi
            rest=${BASH_REMATCH[2]}
          done
          if [ -n "$owned_root" ]; then
            read -r _ _ l p _ <<< "$line"
            key="$owned_root|$l>$p"
          fi
        fi
      elif [ -n "$key" ]; then
        s=0 r=0
        [[ $line =~ bytes_sent:([0-9]+) ]] && s=${BASH_REMATCH[1]}
        [[ $line =~ bytes_received:([0-9]+) ]] && r=${BASH_REMATCH[1]}
        total=$((s + r))
        if [ "$total" -gt 0 ]; then
          cur_net[$key]=$total
          d=$(( total - ${prev_net[$key]:-$total} ))
          if [ "$d" -gt 0 ]; then
            root_net[$owned_root]=$(( ${root_net[$owned_root]:-0} + d ))
          fi
        fi
        key=""
      fi
    done < <(ss -Htinp state established 2>/dev/null)

    for root in $roots; do
      [ "${root_cpu[$root]:-0}" -gt "$MAX_CPU_DELTA" ] && MAX_CPU_DELTA=${root_cpu[$root]}
      [ "${root_net[$root]:-0}" -gt "$MAX_NET_DELTA" ] && MAX_NET_DELTA=${root_net[$root]}
      if [ "${root_cpu[$root]:-0}" -ge "$CPU_THRESH" ] || [ "${root_net[$root]:-0}" -ge "$NET_THRESH" ]; then
        AGENT_BUSY=1
      fi
    done
  fi
  prev_cpu=(); prev_net=()
  for pid in "${!cur_cpu[@]}"; do prev_cpu[$pid]=${cur_cpu[$pid]}; done
  for key in "${!cur_net[@]}"; do prev_net[$key]=${cur_net[$key]}; done
}

echo "started: interval=${INTERVAL}s, busy per agent tree: net>=${BUSY_NET_KB}KB (primary) or cpu>=${BUSY_CPU_SECS}s (fallback) per win, release after $((INTERVAL * IDLE_WINDOWS_TO_RELEASE))s idle, agents='${AGENT_RE}', rdp ports: ${RDP_PORTS}"
sample_agents   # 首次采样只建立基线,不判定

while :; do
  sleep "$INTERVAL"
  reason=""
  [ -e "$FORCE_FILE" ] && reason="manual"
  rdp_active && reason="${reason:+$reason + }RDP connected"
  sample_agents
  metrics="net=$((MAX_NET_DELTA / 1024))KB cpu=$((MAX_CPU_DELTA * 10 / CLK_TCK / 10)).$((MAX_CPU_DELTA * 10 / CLK_TCK % 10))s"
  if [ "$AGENT_BUSY" = 1 ]; then
    reason="${reason:+$reason + }agent busy"
  fi
  if [ -n "$reason" ]; then
    idle_windows=0
    hold "$reason ($metrics)"
    printf 'held|%s|%s\n' "$reason" "$metrics" > "$STATE_FILE"
  else
    if [ -n "$inhibit_pid" ]; then
      idle_windows=$((idle_windows + 1))
      if [ "$idle_windows" -ge "$IDLE_WINDOWS_TO_RELEASE" ]; then
        echo "release: idle for $((idle_windows * INTERVAL))s"
        release
        idle_windows=0
      fi
    fi
    if [ -n "$inhibit_pid" ]; then
      printf 'held|cooling down %ss|%s\n' "$(( (IDLE_WINDOWS_TO_RELEASE - idle_windows) * INTERVAL ))" "$metrics" > "$STATE_FILE"
    else
      printf 'idle||%s\n' "$metrics" > "$STATE_FILE"
    fi
  fi
done
